{
  "kind": "collectionType",
  "collectionName": "faqs",
  "info": {
    "singularName": "faq",
    "pluralName": "faqs",
    "displayName": "FAQ"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "question": { "type": "string", "required": true },
    "answer": { "type": "richtext", "required": true },
    "sort_order": { "type": "integer" },
    "blog": { "type": "relation", "relation": "manyToOne", "target": "api::blog.blog" }
  }
}
